# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

# Local environment config (copy .env.example to .env)
.env

# Tailwind build output — dx generates public/tailwind.css at build time
# (it is linked statically from index.html, so it must exist in the served
# artifact but not in the repo).
/public/tailwind.css
